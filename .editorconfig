root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false   # markdown line breaks need trailing spaces

[*.{yml,yaml,json,proto}]
indent_size = 2

[*.{kt,kts,gradle}]
indent_size = 4

[*.swift]
indent_size = 4

[Makefile]
indent_style = tab
