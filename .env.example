# quiet/.env.example
# Copy to `.env` and fill in real values from 1Password (entry name TBD).
# Real .env is .gitignored — never commit. Spike repo is public until product
# code lands; treat every value here as a credential by default.

# --- Supabase ---
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Anon (public) key — safe to embed in mobile clients
SUPABASE_ANON_KEY=

# Service role key — backend only, NEVER ship in a mobile binary
SUPABASE_SERVICE_ROLE_KEY=

# --- PowerSync Cloud ---
# Instance URL, e.g. https://<id>.powersync.journeyapps.com
POWERSYNC_URL=

# JWT signing key for the dev token mint (spike only; real auth uses Supabase JWTs)
POWERSYNC_DEV_JWT_KEY=

# --- Spike test user (hardcoded; real auth is a later spike) ---
QUIET_TEST_USER_EMAIL=
QUIET_TEST_USER_PASSWORD=
QUIET_TEST_USER_ID=
